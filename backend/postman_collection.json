    {
      "name": "Transaction Management - Basic",
      "item": [
        {
          "name": "Get All Transactions (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/all?skip=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "all"],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Пропустить N записей"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Максимум 1000 записей"
                }
              ]
            },
            "description": "Получить все транзакции с пагинацией\n\nПараметры:\n- skip: Количество записей для пропуска (по умолчанию 0)\n- limit: Максимум 1000 записей (по умолчанию 100)"
          }
        },
        {
          "name": "Get Transactions by Period (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/by_period?from_date=2025-01-01&to_date=2025-12-31&skip=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "by_period"],
              "query": [
                {
                  "key": "from_date",
                  "value": "2025-01-01"
                },
                {
                  "key": "to_date",
                  "value": "2025-12-31"
                },
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Получить транзакции за период с пагинацией\n\nfrom_date: Дата начала в формате YYYY-MM-DD (обязательно)\nto_date: Дата окончания в формате YYYY-MM-DD (обязательно)\nskip: Количество записей для пропуска (по умолчанию 0)\nlimit: Максимум 1000 записей (по умолчанию 100)"
          }
        },
        {
          "name": "Get Transactions by Period and Type (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transaction/by_period_type?from_date=2025-01-01&to_date=2025-12-31&operation_type=debit&skip=0&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "by_period_type"],
              "query": [
                {
                  "key": "from_date",
                  "value": "2025-01-01"
                },
                {
                  "key": "to_date",
                  "value": "2025-12-31"
                },
                {
                  "key": "operation_type",
                  "value": "debit"
                },
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Получить транзакции за период с фильтрацией по типу и пагинацией\n\noperation_type: debit, adding, transfer (обязательно)\nskip: Количество записей для пропуска (по умолчанию 0)\nlimit: Максимум 1000 записей (по умолчанию 100)"
          }
        },
        {
          "name": "Create Transaction - Debit",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FROM\": null,\n  \"TO\": \"{{accountId}}\",\n  \"category\": null,\n  \"type\": \"debit\",\n  \"debitSize\": 5000,\n  \"creditSize\": null,\n  \"exchangeRate\": null,\n  \"date\": \"2025-01-15\",\n  \"description\": \"Покупка продуктов\",\n  \"splitType\": null,\n  \"status\": \"settled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/create",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "create"]
            },
            "description": "Создать транзакцию типа debit (расход)\n\nПоля:\n- FROM: UUID источника средств (опционально для debit)\n- TO: UUID получателя/счета (обязательно для debit)\n- category: UUID категории (опционально)\n- type: 'debit', 'adding', 'transfer' (обязательно)\n- debitSize: Сумма дебета (обязательно)\n- creditSize: Сумма кредита (для transfer)\n- exchangeRate: Курс валюты\n- date: Дата транзакции YYYY-MM-DD (обязательно)\n- description: Описание (опционально)\n- splitType: 'equal', 'percentage', 'amount', 'position'\n- status: 'pending', 'partially_paid', 'settled' (обязательно)"
          }
        },
        {
          "name": "Create Transaction - Adding",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FROM\": null,\n  \"TO\": \"{{accountId}}\",\n  \"type\": \"adding\",\n  \"debitSize\": null,\n  \"creditSize\": 10000,\n  \"date\": \"2025-01-15\",\n  \"description\": \"Пополнение счета\",\n  \"status\": \"settled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/create",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "create"]
            },
            "description": "Создать транзакцию типа adding (дополнение)"
          }
        },
        {
          "name": "Create Transaction - Transfer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"FROM\": \"{{accountIdFrom}}\",\n  \"TO\": \"{{accountIdTo}}\",\n  \"type\": \"transfer\",\n  \"debitSize\": null,\n  \"creditSize\": 5000,\n  \"date\": \"2025-01-15\",\n  \"description\": \"Перевод между счетами\",\n  \"status\": \"settled\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
