              "mode": "raw",
              "raw": "{\n  \"id\": \"{{accountId}}\",\n  \"is_archived\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/account/{{accountId}}/archived",
              "host": ["{{baseUrl}}"],
              "path": ["account", "{{accountId}}", "archived"]
