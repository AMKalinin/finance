            "url": {
              "raw": "{{baseUrl}}/account/{{accountId}}/interest_rate",
              "host": ["{{baseUrl}}"],
              "path": ["account", "{{accountId}}", "interest_rate"]
            },
            "description": "Обновить процентную ставку"
          }
