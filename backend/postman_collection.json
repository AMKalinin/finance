        {
          "name": "Update Account Description",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{accountId}}\",\n  \"description\": \"Новое описание\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/account/{{accountId}}/description",
