              "path": ["account", "{{accountId}}", "description"]
            },
            "description": "Обновить описание учетной записи"
          }
        },
        {
          "name": "Update Interest Rate",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{accountId}}\",\n  \"interest_rate\": 5.5\n}",
