        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/account/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["account", "{{accountId}}"]
            },
            "description": "Удалить учетную запись"
          }
        }
      ]
    },
